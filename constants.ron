(
  // Default channel handle shown in the input field on startup.
  pastel_sketchbook_channel: "@ChrisH-v4e",
  // Channel display name as yt-dlp reports it in `%(uploader)s`. The
  // handle above cannot be used for this: per-video metadata exposes
  // only the display name, and `--flat-playlist` omits it entirely.
  pastel_sketchbook_uploader: "Pastel Sketchbook",

  // --- Ghostty terminal ---
  // TERM_PROGRAM env var value (lowercase).
  ghostty_term_program: "ghostty",
  // Process name in macOS System Events / Accessibility API (matches CFBundleName).
  ghostty_process_name: "Ghostty",

  // --- PiP window ---
  pip_width: 550,
  pip_height: 350,
  pip_margin: 30,

  // --- UI ---
  // Maximum number of tags shown in the Now Playing pane.
  max_display_tags: 7,

  // --- Channel browsing ---
  // Number of videos fetched on the initial channel load.
  channel_initial_size: 30,
  // Page size for subsequent "load more" fetches.
  channel_page_size: 20,

  // --- Transcription ---
  // Duration of each audio chunk downloaded for whisper (seconds).
  chunk_secs: 30,
  // Minimum WAV file size to consider a chunk valid (~1s of 16kHz mono 16-bit).
  min_chunk_bytes: 32000,

  // --- YouTube / yt-dlp ---
  // Frame rate for ffmpeg video frame extraction (frames per second).
  frame_extract_fps: 0.5,
  // Width of extracted video frames (height auto-scales to preserve aspect ratio).
  // 1280 matches the largest YouTube thumbnail and looks sharp in a large
  // Kitty/Sixel pane. Raise it if you have ffmpeg to spare and a big display;
  // cost is CPU, disk, and a slower first extraction.
  frame_extract_width: 1280,
  // Maximum concurrent yt-dlp enrichment processes.
  // Low on purpose: each video is a separate request, and YouTube
  // rate-limits bursts far below what raw throughput would suggest.
  enrich_concurrency: 3,
  // Ceiling on requests per page load. A channel can list hundreds of
  // videos; enriching every one is what gets an IP throttled.
  enrich_limit: 40,
  // yt-dlp print template for listing commands (7 tab-separated fields).
  // Fields: title, id, upload_date, tags, duration, view_count, uploader.
  // In --flat-playlist mode, tags will be "NA" (only available via per-video enrichment).
  print_format: "%(title)s\t%(id)s\t%(upload_date>%Y-%m-%d)s\t%(tags)s\t%(duration_string)s\t%(view_count)s\t%(uploader)s",
  // yt-dlp print template for per-video metadata enrichment.
  enrich_format: "%(id)s\t%(upload_date>%Y-%m-%d)s\t%(tags)s\t%(duration_string)s\t%(view_count)s\t%(uploader)s",
)
